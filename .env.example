# Telegram bot token from @BotFather (required)
TELOXIDE_TOKEN=your_bot_token_here

# Challenge timeout in seconds (1..=300, default: 300)
BOTIFIL_CHALLENGE_TTL_SECS=300

# Maximum challenge attempts before decline (1..=5, default: 2)
BOTIFIL_MAX_ATTEMPTS=2

# Comma-separated allowed chat IDs (empty allows all chats)
BOTIFIL_ALLOWED_CHATS=

# Persistent redb session database path (default: ./data/botifil.redb)
BOTIFIL_DB_PATH=./data/botifil.redb

# Log level filter (trace, debug, info, warn, error)
RUST_LOG=info
